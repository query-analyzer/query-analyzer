<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone benchmark module. It is intentionally NOT listed in the root
      query-analyzer pom's <modules>, so it never affects the library build.

      How to run:
        1) Build & install the library locally (publishes core to ~/.m2):
             cd query-analyzer && mvn clean install -DskipTests
        2) Run the benchmark:
             cd query-analyzer-benchmark && mvn test
        3) Read the results:
             target/benchmark-accuracy.csv
             target/benchmark-report.md

      If you prefer the released artifact from Maven Central instead of a local
      build, bump <query-analyzer.version> below to the published version.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.query-analyzer</groupId>
    <artifactId>query-analyzer-benchmark</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Query Analyzer - Benchmark</name>
    <description>Accuracy (precision/recall) and overhead benchmark comparing
        query-analyzer against the count-based N+1 heuristic used by test-time
        detectors such as QuickPerf.</description>

    <properties>
        <java.version>17</java.version>
        <query-analyzer.version>1.2.7</query-analyzer.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- The tool under test: only the core detector engine is needed. -->
        <dependency>
            <groupId>io.github.query-analyzer</groupId>
            <artifactId>query-analyzer-core</artifactId>
            <version>${query-analyzer.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Live competitor: Hypersistence Utils (Vlad Mihalcea), SB3/Hibernate 6.3
             native. SQLStatementCountValidator counts statements via datasource-proxy. -->
        <dependency>
            <groupId>io.hypersistence</groupId>
            <artifactId>hypersistence-utils-hibernate-63</artifactId>
            <version>3.15.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.ttddyy</groupId>
            <artifactId>datasource-proxy</artifactId>
            <version>1.10</version>
            <scope>test</scope>
        </dependency>

        <!-- Real PostgreSQL for the overhead/EXPLAIN run (RQ4). zonky boots an actual
             Postgres binary as the current user - no Docker, no root - so overhead can be
             reported as a fraction of a genuine DB request and the tool's EXPLAIN-based
             plan analysis can be exercised against a real engine. Test scope only. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-database-spring-test</artifactId>
            <version>2.5.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>

        <!-- Live competitor #2: JPlusOne (adgadev) - a REAL automatic N+1 detector (not a
             counter). v2.0.0 is the only other test-time tool ported to Spring Boot 3 /
             Hibernate 6 / Jakarta, so it can run on the same stack. It records a session
             tree; IMPLICIT operations are lazy initialisations (its N+1 signal). -->
        <dependency>
            <groupId>com.adgadev.jplusone</groupId>
            <artifactId>jplusone-core</artifactId>
            <version>2.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Benchmarks print to stdout; keep output visible. -->
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
