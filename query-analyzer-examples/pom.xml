<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.query-analyzer</groupId>
    <artifactId>query-analyzer-parent</artifactId>
    <version>1.2.1</version>
  </parent>

  <artifactId>query-analyzer-examples</artifactId>
  <packaging>pom</packaging>

  <name>Query Analyzer Examples</name>
  <description>Reference implementations demonstrating Query Analyzer capabilities</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.4.0</version>
        <extensions>true</extensions>
        <configuration>
          <skipPublishing>true</skipPublishing>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <modules>
    <module>example-basic</module>
    <module>example-postgres</module>
  </modules>
</project>
